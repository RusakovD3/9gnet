// Interactive mono voice over RTP/UDP using Opus.
// target_bitrate_kbps is codec payload only; IP/UDP/RTP/L2 overhead is
// calculated separately by packet_simulator.py. A 20 ms frame gives 50 pps.
SLA "L1_GOLD_VOICE_OPUS" {
    grade: "gold";
    traffic: "voice";
    codec: "Opus fullband mono / RTP/UDP";
    target_bitrate_kbps: 32;
    min_bitrate_kbps: 24;
    latency_budget_ms: 80;
    packet_loss_budget_percent: 0.1;
    jitter_budget_ms: 20;
    monitoring_interval_seconds: 1;
    bitrate_drop_window_seconds: 10;
    packetization_ms: 20;
    rtp_clock_rate_hz: 48000;
    // Dynamic RTP payload type selected by this model; RFC 7587 does not
    // reserve a mandatory static payload type for Opus.
    rtp_payload_type: 111;
    channels: 1;
    inband_fec: "enabled";
    dtx: "disabled";

    SLO "Bitrate" {
        metric: "bitrate_kbps";
        statistic: "p95";
        operator: GTE;
        value: 24;
        unit: "kbps";
        window_seconds: 10;
    }
    SLO "Latency" {
        metric: "latency_ms";
        statistic: "p95";
        operator: LTE;
        value: 80;
        unit: "ms";
        window_seconds: 10;
    }
    SLO "PacketLoss" {
        metric: "packet_loss_percent";
        statistic: "avg";
        operator: LTE;
        value: 0.1;
        unit: "%";
        window_seconds: 10;
    }
    SLO "Jitter" {
        metric: "jitter_ms";
        statistic: "p95";
        operator: LTE;
        value: 20;
        unit: "ms";
        window_seconds: 10;
    }
}

