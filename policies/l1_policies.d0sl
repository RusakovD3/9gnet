// L1 d0sl policies for G-Net subscriber layer
// Python parses this file and uses it as the source of truth for L1 tensors and monitoring.
// Protocol/codec references: RFC 7587 (Opus), RFC 6184 (H.264 over RTP),
// RFC 959 (FTP), RFC 1035 + RFC 7766 (DNS), W3C WebRTC and ITU-T G.114.
// Low-Latency HLS follows the Apple HLS authoring profile. SLA bitrates,
// availability and grade boundaries are explicit GNet9 engineering policies;
// the cited standards define protocols/codecs, not operator SLA values.

// VLC is the delivery platform, not a codec. The requested 320/128/64 kbit/s
// values describe the Opus audio component. H.264 video is budgeted separately.
SLA "L1_GOLD_VLC_AV" {
    grade: "gold"; traffic: "vlc_av"; codec: "VLC / Opus + H.264/AVC over RTP/UDP";
    audio_bitrate_kbps: 320; video_bitrate_kbps: 4000;
    target_bitrate_kbps: 4320; min_bitrate_kbps: 3500;
    latency_budget_ms: 150; packet_loss_budget_percent: 0.5; jitter_budget_ms: 30;
    monitoring_interval_seconds: 1; bitrate_drop_window_seconds: 10;
    SLO "Latency" { metric: "latency_ms"; statistic: "p95"; operator: LTE; value: 150; unit: "ms"; window_seconds: 10; }
}

SLA "L1_SILVER_VLC_AV" {
    grade: "silver"; traffic: "vlc_av"; codec: "VLC / Opus + H.264/AVC over RTP/UDP";
    audio_bitrate_kbps: 128; video_bitrate_kbps: 2000;
    target_bitrate_kbps: 2128; min_bitrate_kbps: 1600;
    latency_budget_ms: 250; packet_loss_budget_percent: 1.0; jitter_budget_ms: 50;
    monitoring_interval_seconds: 1; bitrate_drop_window_seconds: 10;
    SLO "Latency" { metric: "latency_ms"; statistic: "p95"; operator: LTE; value: 250; unit: "ms"; window_seconds: 10; }
}

SLA "L1_BRONZE_VLC_AV" {
    grade: "bronze"; traffic: "vlc_av"; codec: "VLC / Opus + H.264/AVC over RTP/UDP";
    audio_bitrate_kbps: 64; video_bitrate_kbps: 1000;
    target_bitrate_kbps: 1064; min_bitrate_kbps: 700;
    latency_budget_ms: 400; packet_loss_budget_percent: 2.0; jitter_budget_ms: 80;
    monitoring_interval_seconds: 1; bitrate_drop_window_seconds: 10;
    SLO "Latency" { metric: "latency_ms"; statistic: "p95"; operator: LTE; value: 400; unit: "ms"; window_seconds: 10; }
}

// Interactive conference profile. Video and audio have separate budgets;
// latency_budget_ms is the stricter video value used by generic L1 monitoring.
SLA "L1_GOLD_VIDEO_CONFERENCE" {
    grade: "gold"; traffic: "video_conference"; codec: "WebRTC / Opus + VP8 or H.264 Constrained Baseline / DTLS-SRTP";
    audio_bitrate_kbps: 64; video_bitrate_kbps: 4032;
    target_bitrate_kbps: 4096; min_bitrate_kbps: 3000;
    latency_budget_ms: 70; video_latency_budget_ms: 70; audio_latency_budget_ms: 150; failure_latency_ms: 600;
    packet_loss_budget_percent: 0.3; jitter_budget_ms: 20;
    monitoring_interval_seconds: 1; bitrate_drop_window_seconds: 10;
    SLO "VideoLatency" { metric: "latency_ms"; statistic: "p95"; operator: LTE; value: 70; unit: "ms"; window_seconds: 10; }
}

SLA "L1_SILVER_VIDEO_CONFERENCE" {
    grade: "silver"; traffic: "video_conference"; codec: "WebRTC / Opus + VP8 or H.264 Constrained Baseline / DTLS-SRTP";
    audio_bitrate_kbps: 48; video_bitrate_kbps: 2000;
    target_bitrate_kbps: 2048; min_bitrate_kbps: 1500;
    latency_budget_ms: 150; video_latency_budget_ms: 150; audio_latency_budget_ms: 300; failure_latency_ms: 600;
    packet_loss_budget_percent: 1.0; jitter_budget_ms: 30;
    monitoring_interval_seconds: 1; bitrate_drop_window_seconds: 10;
    SLO "VideoLatency" { metric: "latency_ms"; statistic: "p95"; operator: LTE; value: 150; unit: "ms"; window_seconds: 10; }
}

SLA "L1_BRONZE_VIDEO_CONFERENCE" {
    grade: "bronze"; traffic: "video_conference"; codec: "WebRTC / Opus + VP8 or H.264 Constrained Baseline / DTLS-SRTP";
    audio_bitrate_kbps: 32; video_bitrate_kbps: 992;
    target_bitrate_kbps: 1024; min_bitrate_kbps: 700;
    latency_budget_ms: 250; video_latency_budget_ms: 250; audio_latency_budget_ms: 400; failure_latency_ms: 600;
    packet_loss_budget_percent: 2.0; jitter_budget_ms: 50;
    monitoring_interval_seconds: 1; bitrate_drop_window_seconds: 10;
    SLO "VideoLatency" { metric: "latency_ms"; statistic: "p95"; operator: LTE; value: 250; unit: "ms"; window_seconds: 10; }
}

// Low-latency live streaming is classified in seconds, not milliseconds.
SLA "L1_GOLD_LIVE_STREAMING" {
    grade: "gold"; traffic: "live_streaming"; codec: "Low-Latency HLS / AAC-LC + H.264/AVC";
    audio_bitrate_kbps: 128; video_bitrate_kbps: 5872;
    target_bitrate_kbps: 6000; min_bitrate_kbps: 4500;
    latency_budget_ms: 2000; failure_latency_ms: 10000;
    packet_loss_budget_percent: 0.5; jitter_budget_ms: 250;
    startup_time_budget_ms: 1500; rebuffer_ratio_budget_percent: 0.1;
    segment_deadline_miss_budget_percent: 0.5;
    primary_slo_semantics: "live-edge latency, startup, rebuffer ratio and part deadline misses";
    monitoring_interval_seconds: 1; bitrate_drop_window_seconds: 10;
    SLO "GlassToGlassLatency" { metric: "latency_ms"; statistic: "p95"; operator: LTE; value: 2000; unit: "ms"; window_seconds: 10; }
}

SLA "L1_SILVER_LIVE_STREAMING" {
    grade: "silver"; traffic: "live_streaming"; codec: "Low-Latency HLS / AAC-LC + H.264/AVC";
    audio_bitrate_kbps: 96; video_bitrate_kbps: 3404;
    target_bitrate_kbps: 3500; min_bitrate_kbps: 2500;
    latency_budget_ms: 3000; failure_latency_ms: 10000;
    packet_loss_budget_percent: 1.0; jitter_budget_ms: 400;
    startup_time_budget_ms: 2500; rebuffer_ratio_budget_percent: 0.5;
    segment_deadline_miss_budget_percent: 1.0;
    primary_slo_semantics: "live-edge latency, startup, rebuffer ratio and part deadline misses";
    monitoring_interval_seconds: 1; bitrate_drop_window_seconds: 10;
    SLO "GlassToGlassLatency" { metric: "latency_ms"; statistic: "p95"; operator: LTE; value: 3000; unit: "ms"; window_seconds: 10; }
}

SLA "L1_BRONZE_LIVE_STREAMING" {
    grade: "bronze"; traffic: "live_streaming"; codec: "Low-Latency HLS / AAC-LC + H.264/AVC";
    audio_bitrate_kbps: 64; video_bitrate_kbps: 1936;
    target_bitrate_kbps: 2000; min_bitrate_kbps: 1200;
    latency_budget_ms: 5000; failure_latency_ms: 10000;
    packet_loss_budget_percent: 2.0; jitter_budget_ms: 700;
    startup_time_budget_ms: 4000; rebuffer_ratio_budget_percent: 1.5;
    segment_deadline_miss_budget_percent: 3.0;
    primary_slo_semantics: "live-edge latency, startup, rebuffer ratio and part deadline misses";
    monitoring_interval_seconds: 1; bitrate_drop_window_seconds: 10;
    SLO "GlassToGlassLatency" { metric: "latency_ms"; statistic: "p95"; operator: LTE; value: 5000; unit: "ms"; window_seconds: 10; }
}

SLA "L1_GOLD_FTP" {
    grade: "gold";
    traffic: "ftp";
    codec: "FTP over TCP/IP / binary/octet-stream";
    target_bitrate_kbps: 4096;
    min_bitrate_kbps: 3072;
    latency_budget_ms: 300;
    packet_loss_budget_percent: 0.5;
    tcp_retransmission_budget_percent: 0.1;
    file_size_mib: 50;
    completion_time_budget_seconds: 140;
    primary_slo_semantics: "goodput, file completion time, checksum success and TCP retransmission ratio";
    jitter_budget_ms: 120;
    monitoring_interval_seconds: 1;
    bitrate_drop_window_seconds: 10;

    SLO "Bitrate" {
        metric: "bitrate_kbps";
        statistic: "p95";
        operator: GTE;
        value: 3072;
        unit: "kbps";
        window_seconds: 10;
    }

    SLO "Latency" {
        metric: "latency_ms";
        statistic: "p95";
        operator: LTE;
        value: 300;
        unit: "ms";
        window_seconds: 10;
    }

    SLO "PacketLoss" {
        metric: "packet_loss_percent";
        statistic: "avg";
        operator: LTE;
        value: 0.5;
        unit: "%";
        window_seconds: 10;
    }

    SLO "Jitter" {
        metric: "jitter_ms";
        statistic: "p95";
        operator: LTE;
        value: 120;
        unit: "ms";
        window_seconds: 10;
    }
}

SLA "L1_GOLD_DNS" {
    grade: "gold";
    traffic: "dns";
    codec: "DNS wire format over UDP with TCP fallback";
    target_bitrate_kbps: 64;
    min_bitrate_kbps: 32;
    // Внутренний операторский p95-бюджет GNet9: RFC 1035/7766 не задают
    // нормативного RTT. 50 мс оставляет реалистичный запас для резервного
    // access и server failover, не превращая DNS Gold в best-effort.
    latency_budget_ms: 50;
    packet_loss_budget_percent: 0.5;
    jitter_budget_ms: 10;
    request_rate_qps: 2.0;
    timeout_budget_percent: 0.1;
    primary_slo_semantics: "p95/p99 response time, timeout and SERVFAIL ratio, TCP fallback success";
    monitoring_interval_seconds: 1;
    bitrate_drop_window_seconds: 10;

    SLO "Bitrate" {
        metric: "bitrate_kbps";
        statistic: "p95";
        operator: GTE;
        value: 32;
        unit: "kbps";
        window_seconds: 10;
    }

    SLO "Latency" {
        metric: "latency_ms";
        statistic: "p95";
        operator: LTE;
        value: 50;
        unit: "ms";
        window_seconds: 10;
    }

    SLO "PacketLoss" {
        metric: "packet_loss_percent";
        statistic: "avg";
        operator: LTE;
        value: 0.5;
        unit: "%";
        window_seconds: 10;
    }

    SLO "Jitter" {
        metric: "jitter_ms";
        statistic: "p95";
        operator: LTE;
        value: 10;
        unit: "ms";
        window_seconds: 10;
    }
}

